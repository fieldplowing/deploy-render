{
  "compileOnSave": false,
  "compilerOptions": {
    /* 言語と環境（Node.js v22+ / TypeScript 6.0 向け） */
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    /* スクリプト実行専用（.js や .d.ts を出力しない） */
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* 型チェックと厳格性 */
    "strict": true,
    "useUnknownInCatchVariables": false,
    "noUnusedParameters": true,
    "noUnusedLocals": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["sync.ts"],
  "exclude": ["node_modules", "bin", "public"]
}
